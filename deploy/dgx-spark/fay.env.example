# Bind Fay to the DGX Spark tailnet address, not to every interface.
FAY_BIND_HOST=127.0.0.1
FAY_SYSTEM_CONF_PATH=%h/.config/fay/system.conf
FAY_CONFIG_JSON_PATH=%h/.config/fay/config.json
FAY_MCP_DATA_DIR=%h/.local/share/fay/mcp
FAY_LLM_MAX_TOKENS=1024
FAY_LLM_DISABLE_THINKING=1
FAY_LLM_HEALTH_URL=http://127.0.0.1:8090/v1/models

# Local Qwen3-TTS and lightweight Whisper speech services.
FAY_OPENAI_TTS_BASE_URL=http://127.0.0.1:4400/v1
FAY_OPENAI_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
FAY_OPENAI_TTS_VOICE=Serena
FAY_OPENAI_TTS_TIMEOUT=90
FAY_WHISPER_API_URL=http://127.0.0.1:4397/api/voice/transcribe
FAY_WHISPER_MODEL=base
FAY_WHISPER_LANGUAGE=en
FAY_WHISPER_UPLOAD_ROOT=%h/.codex-studio-v2/voice
FAY_WHISPER_TIMEOUT=90
FAY_ASR_ALLOWED_ROOT=%h/Workspace/01_Projects/Active/Fay/cache_data

# Expose Fay's memory, broadcast, and aggregated tools as an MCP SSE server.
FAY_MCP_SSE_ENABLE=1
FAY_MCP_SSE_HOST=127.0.0.1
FAY_MCP_SSE_PORT=8766
FAY_MCP_SSE_PATH=/sse
FAY_MCP_MSG_PATH=/messages
