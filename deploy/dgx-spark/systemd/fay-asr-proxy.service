[Unit]
Description=Fay Voxtral realtime ASR compatibility proxy
After=network-online.target codex-studio-voxtral-realtime.service
Wants=network-online.target codex-studio-voxtral-realtime.service

[Service]
Type=simple
WorkingDirectory=%h/Workspace/01_Projects/Active/Fay
EnvironmentFile=%h/.config/fay/fay.env
ExecStart=%h/Workspace/01_Projects/Active/Fay/.venv/bin/python deploy/dgx-spark/voxtral_asr_proxy.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
